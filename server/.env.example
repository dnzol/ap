# Скопируйте в .env и задайте длинный случайный токен:  openssl rand -hex 32
API_TOKEN=change-me
# Необязательные параметры сервера:
# MAX_UPLOAD_MB=50
# MIN_OBS=2
# MAX_ACC_M=100

# ---------- Шлюз трекеров (docker compose --profile gateway up -d) ----------
# Куда пересылать данные: адрес и порт приёма трекеров в Аксенте (обязательно)
UPSTREAM_HOST=hw.axenta.cloud
UPSTREAM_PORT=21889
# Подмена координат при valid_nav=0.
#   пусто    = режим наблюдения: пакеты НЕ меняются, шлюз только пересылает, учится и пишет в лог «подставил бы»
#   a,b      = подмена только для этих IMEI (пилот)
#   *        = для всех
SUBST_IMEIS=
# Имя параметра с флагом навигации и шаблон имён параметров со списком Wi-Fi (уточнить по образцу пакета)
# VALID_NAV_PARAM=valid_nav
# WIFI_PARAM_RE=^wifi
# Имя параметра-метки подставленных координат (будет nav_src:3:wifi)
# MARK_PARAM=nav_src
# После подмены: keep = оставить valid_nav=0, 1 = поставить 1 (если Аксента иначе не показывает точку)
# VALID_NAV_AFTER=keep
# Если Аксента считает точку годной только при ненулевом числе спутников, можно задать, например, 4
# SATS_OVERRIDE=
# Пополнение базы из пакетов с valid_nav=1 (LEARN=0 отключает)
# LEARN=1
# LEARN_MIN_SATS=5
# LEARN_MAX_HDOP=2.5
# LEARN_MAX_SPEED_KMH=40
# Гашение дрожания: смещение меньше этого (м) считается стоянкой
# STATIONARY_M=30

# ---------- Перехватчик (docker compose --profile capture up -d) ----------
# Использует те же UPSTREAM_HOST и UPSTREAM_PORT. Лог: ./data/capture.log (внутри контейнера /data/capture.log)
# CAPTURE_MAX_FRAMES=400
